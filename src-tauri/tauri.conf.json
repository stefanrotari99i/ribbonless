{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ribbonless",
  "version": "0.1.0",
  "identifier": "io.github.stefanrotari99i.ribbonless",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ribbonless",
        "width": 1000,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        },
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Word document",
        "role": "Viewer"
      }
    ],
    "publisher": "Stefan Rotari",
    "copyright": "Copyright (c) 2026 Stefan Rotari. MIT License.",
    "category": "Productivity",
    "shortDescription": "A calm, fast editor for Word documents",
    "longDescription": "Ribbonless opens and edits .docx files in a clean, quiet window: styles, lists, tables, images, links, find and replace, version history and more, saved back as real Word files.",
    "homepage": "https://github.com/stefanrotari99i/ribbonless",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    }
  }
}
